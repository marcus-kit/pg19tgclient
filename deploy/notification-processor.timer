# /etc/systemd/system/pg19-notification-processor.timer
# Таймер для обработки очереди уведомлений каждые 30 секунд

[Unit]
Description=PG19 Community Notification Processor Timer
Requires=pg19-notification-processor.service

[Timer]
# Запуск каждые 30 секунд
OnBootSec=30
OnUnitActiveSec=30
AccuracySec=1s

[Install]
WantedBy=timers.target
